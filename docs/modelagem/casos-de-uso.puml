@startuml
left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle

title StockFlow - Diagrama de Casos de Uso

actor "Usuário autenticado" as User
actor "Administrador" as Admin
actor "Gestor" as Manager
actor "Operador" as Operator

Admin --|> User
Manager --|> User
Operator --|> User

rectangle "StockFlow" {
  usecase "Autenticar-se" as UCLogin
  usecase "Encerrar sessão" as UCLogout
  usecase "Alterar preferência de idioma" as UCLanguage
  usecase "Visualizar dashboard" as UCDashboard
  usecase "Consultar produtos e inventário" as UCProducts
  usecase "Consultar categorias" as UCCategories
  usecase "Consultar fornecedores" as UCSuppliers
  usecase "Consultar movimentações e histórico" as UCHistory
  usecase "Registrar entrada de estoque" as UCEntry
  usecase "Registrar saída de estoque" as UCExit
  usecase "Manter produtos" as UCManageProducts
  usecase "Manter categorias" as UCManageCategories
  usecase "Manter fornecedores" as UCManageSuppliers
  usecase "Administrar usuários" as UCUsers
  usecase "Gerar relatórios gerenciais" as UCReports
}

User --> UCLogout
User --> UCLanguage
User --> UCDashboard
User --> UCProducts
User --> UCCategories
User --> UCSuppliers
User --> UCHistory
User --> UCEntry
User --> UCExit

Admin --> UCLogin
Manager --> UCLogin
Operator --> UCLogin

Admin --> UCManageProducts
Admin --> UCManageCategories
Admin --> UCManageSuppliers
Admin --> UCUsers
Manager --> UCManageProducts
Manager --> UCManageCategories
Manager --> UCManageSuppliers

note right of UCReports
  Funcionalidade futura.
  A tela atual é um placeholder;
  não existe endpoint de relatório.
end note

@enduml
