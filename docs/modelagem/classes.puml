@startuml
title StockFlow - Modelo de Dados (Prisma / PostgreSQL)
skinparam classAttributeIconSize 0
hide methods

' Enums persistidos

enum UserRole {
  ADMIN
  MANAGER
  OPERATOR
}

enum StockMovementType {
  ENTRY
  EXIT
}

class User {
  +id: UUID <<PK>>
  +name: String
  +email: String <<UNIQUE>>
  +passwordHash: String
  +role: UserRole = OPERATOR
  +language: String(5) = en
  +isActive: Boolean = true
  +createdAt: DateTime
  +updatedAt: DateTime
}

class Session {
  +id: UUID <<PK>>
  +userId: UUID <<FK>>
  +tokenHash: String <<UNIQUE>>
  +expiresAt: DateTime
  +revokedAt: DateTime?
  +createdAt: DateTime
}

class Category {
  +id: UUID <<PK>>
  +name: String <<UNIQUE>>
  +description: String?
  +isActive: Boolean = true
  +createdAt: DateTime
  +updatedAt: DateTime
}

class Product {
  +id: UUID <<PK>>
  +sku: String <<UNIQUE>>
  +name: String
  +description: String?
  +price: Decimal(12,2) = 0
  +quantity: Int = 0
  +minStock: Int = 0
  +isActive: Boolean = true
  +createdAt: DateTime
  +updatedAt: DateTime
  +categoryId: UUID? <<FK>>
  +unit: String = UN
  +location: String?
}

class StockMovement {
  +id: UUID <<PK>>
  +productId: UUID <<FK>>
  +performedById: UUID? <<FK>>
  +type: StockMovementType
  +quantity: Int
  +supplierId: UUID? <<FK>>
  +unitCost: Decimal(12,2)?
  +recipient: String?
  +notes: String?
  +createdAt: DateTime
}

class Supplier {
  +id: UUID <<PK>>
  +name: String
  +taxId: String? <<UNIQUE>>
  +email: String?
  +phone: String?
  +address: String?
  +notes: String?
  +isActive: Boolean = true
  +createdAt: DateTime
  +updatedAt: DateTime
}

User "1" -- "0..*" Session : sessions
Category "0..1" -- "0..*" Product : classifies
Product "1" -- "0..*" StockMovement : movements
User "0..1" -- "0..*" StockMovement : performedBy
Supplier "0..1" -- "0..*" StockMovement : supplier

note bottom of StockMovement
  ENTRY aumenta Product.quantity.
  EXIT reduz Product.quantity.
  Saldo e movimentação são atualizados
  dentro da mesma transação.
end note

note bottom of User
  passwordHash armazena hash Argon2id,
  nunca a senha em texto puro.
end note

@enduml
